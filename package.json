{
  "name": "fabric-weaver",
  "version": "0.0.1",
  "description": "Typescript utility for hyperledger fabric",
  "type": "module",
  "scripts": {
    "postinstall": "npm run setup",
    "build": "rimraf ./lib && rimraf ./dist && gulp dev",
    "build:prod": "rimraf ./lib && rimraf ./dist && gulp prod",
    "test": "jest --testPathPattern=\"/tests/unit\" --passWithNoTests --detectOpenHandles",
    "test:integration": "jest --testPathPattern=\"/tests/(integration)\" --passWithNoTests --detectOpenHandles",
    "test:all": "jest --testPathPattern=\"/tests/(unit|integration)\" --passWithNoTests --detectOpenHandles",
    "coverage": "rimraf ./workdocs/reports/data/*.json && npm run test:all -- --coverage --config=./workdocs/reports/jest.report.config.ts && cd workdocs/reports && jest-coverage-badges",
    "setup": "npx gulp setup --docker=false --samples=false",
    "reset": "rm -rf * && git checkout . && git pull && npm run install",
    "flash-forward-fabric": "npx gulp updateFabric",
    "test:circular": "dpdm -T --no-warning --no-tree ./src/index.ts",
    "flash-forward": "npx npm-check-updates -u && npm install",
    "lint": "eslint .",
    "lint-fix": "eslint --fix ."
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "lib",
    "dist"
  ],
  "keywords": [
    "plantuml",
    "mermaid",
    "uml",
    "drawio",
    "mddocs",
    "md",
    "jsdoc",
    "doc",
    "docs",
    "documentation",
    "test",
    "reports",
    "ci/cd",
    "ci",
    "cd",
    "fabric",
    "hyperledger",
    "typescript",
    "ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagacito/fabric-weaver.git"
  },
  "author": "Vitor Nogueira",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bagacito/fabric-weaver/issues"
  },
  "homepage": "https://github.com/bagacito/fabric-weaver#readme",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/jest": "^29.5.14",
    "@types/prompts": "^2.4.9",
    "dpdm": "^3.14.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "gulp": "^5.0.0",
    "gulp-if": "^3.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-run-command": "^0.0.10",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "gulp-uglify": "^3.0.2",
    "jest": "^29.7.0",
    "jest-coverage-badges": "^1.1.2",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "merge-stream": "^2.0.0",
    "npm-check-updates": "^17.1.16",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "undici-types": "^7.7.0",
    "vinyl-named": "^1.1.0",
    "webpack-node-externals": "^3.0.0",
    "webpack-stream": "^7.0.0"
  },
  "overrides": {
    "gulp-run-command": {
      "cross-spawn": "^7.0.6"
    }
  }
}
